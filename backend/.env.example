# Copy to backend/.env for a local `uvicorn app.main:app` run.
# Generate values, never reuse the examples:
#   SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://wellcosting:change-me@localhost:5432/wellcosting
SECRET_KEY=replace-with-a-long-cryptographically-random-secret
SECURE_COOKIES=false
CORS_ORIGINS=http://localhost:5173
# Comma-separated proxy addresses/CIDRs whose X-Forwarded-For may be believed.
TRUSTED_PROXY_IPS=

# Password lifecycle (0 disables age expiry — only with an external identity provider).
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_EXPIRY_WARNING_DAYS=14
PASSWORD_HISTORY_LIMIT=5
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# A new account must choose its own password on first sign-in (defaults to true in production).
FORCE_PASSWORD_CHANGE_ON_CREATE=true

# Optional unattended first boot: seeded when the database has no administrator.
BOOTSTRAP_ADMIN_ON_STARTUP=true
SEED_ORG_SLUG=
SEED_ORG_NAME=
SEED_OWNER_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
