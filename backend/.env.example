DATABASE_URL=postgresql+psycopg://wellcosting:change-me@localhost:5432/wellcosting
SECRET_KEY=replace-with-a-long-cryptographically-random-secret
SECURE_COOKIES=false
CORS_ORIGINS=http://localhost:5173

# Optional unattended first boot: seeded when the database has no administrator.
# Leave blank and `python -m app.seed` asks interactively instead.
BOOTSTRAP_ADMIN_ON_STARTUP=true
SEED_ORG_SLUG=
SEED_ORG_NAME=
SEED_OWNER_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
